# Copy to .env.prod and fill in, then:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# Every value here is required except where a default is noted. The compose file
# refuses to start rather than quietly defaulting a password — unlike the
# development stack, where app/app/app is fine precisely because nothing is
# exposed beyond your machine.

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# The origin browsers will actually use. Sets CORS on the API.
PUBLIC_ORIGIN=https://example.com

# Host port nginx binds to. Put TLS in front of this — your platform's load
# balancer, or Caddy — rather than terminating it in the container.
PUBLIC_PORT=80

# Which interface that port is published on. 127.0.0.1 when a TLS proxy on the
# same host (Caddy) sits in front — otherwise the plain-HTTP port is reachable
# from outside past ufw, because Docker writes its own iptables rules.
# PUBLIC_BIND_ADDRESS=0.0.0.0

# debug | info | warning | error. Logs are JSON in production.
LOG_LEVEL=info

# Sample recipients and an opening balance. Off by default here and on in
# development: they are exactly what a demo wants and exactly what a real
# deployment does not. The chart of accounts is seeded either way, because no
# transfer can be authorised without it.
SEED_DEMO_DATA=false
